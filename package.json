{
  "name": "walkz",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "demo": "npm run build --silent && node scripts/demo-local.mjs",
    "test": "vitest run",
    "test:types": "tsc -p tsconfig.test.json --noEmit --pretty false",
    "typecheck": "npm run build && npm run test:types",
    "verify": "npm run typecheck && npm test",
    "walkz": "node apps/cli/dist/bin.js"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
