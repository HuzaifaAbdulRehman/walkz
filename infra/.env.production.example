# Copy this file to infra/.env.production and keep the copy off Git.
# Use image IDs from artifacts/release-manifest.json for a local deployment.
# A registry deployment uses repository@sha256:digest references instead.
WALKZ_API_IMAGE=sha256:replace-with-the-api-image-id
WALKZ_WEB_IMAGE=sha256:replace-with-the-web-image-id
WALKZ_WORKER_IMAGE=sha256:replace-with-the-worker-image-id

# Bind to loopback when a host-level HTTPS reverse proxy owns the public edge.
WALKZ_BIND_ADDRESS=127.0.0.1
WALKZ_HTTP_PORT=3000
WALKZ_DOCKER_GID=0
WALKZ_POSTGRES_VOLUME=walkz-postgres-data
WALKZ_PROOF_VOLUME=walkz-proof-workspaces

POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password

GITHUB_APP_ID=replace-with-your-github-app-id
GITHUB_PRIVATE_KEY_BASE64=replace-with-a-base64-encoded-pem-private-key
GITHUB_CLIENT_ID=replace-with-your-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-your-github-oauth-client-secret
GITHUB_OAUTH_CALLBACK_URL=https://replace-me.example/auth/github/callback
WALKZ_PUBLIC_URL=https://replace-me.example
GITHUB_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
WALKZ_OAUTH_STATE_SECRET=replace-with-at-least-32-random-characters

WALKZ_CREDENTIAL_ACTIVE_KEY_ID=production-2026
WALKZ_CREDENTIAL_KEYS_JSON={"production-2026":"replace-with-a-base64-encoded-32-byte-key"}
