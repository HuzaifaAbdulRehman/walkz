# Copy this file to infra/.env. Do not commit infra/.env.
POSTGRES_PASSWORD=replace-with-a-long-local-password

# GitHub App settings. The callback and webhook URLs must be public HTTPS URLs
# when GitHub sends real traffic to this local stack.
GITHUB_APP_ID=replace-with-your-github-app-id
GITHUB_PRIVATE_KEY_BASE64=replace-with-a-base64-encoded-pem-private-key
GITHUB_CLIENT_ID=replace-with-your-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-your-github-oauth-client-secret
GITHUB_OAUTH_CALLBACK_URL=https://replace-me.example/auth/github/callback
GITHUB_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
WALKZ_OAUTH_STATE_SECRET=replace-with-at-least-32-random-characters
WALKZ_PROMPT_VERSION=walkz-review-v1

# Worker encryption key. Generate 32 random bytes, encode them as base64, and
# use the same key ID in both values.
WALKZ_CREDENTIAL_ACTIVE_KEY_ID=local-2026
WALKZ_CREDENTIAL_KEYS_JSON={"local-2026":"replace-with-a-base64-encoded-32-byte-key"}
